# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca lo subas a un repositorio.

# Token que protege /suma, /process y /ai_validator (Authorization: Bearer <token>).
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# No es el authtoken de ngrok: ese se configura aparte con
#   ngrok config add-authtoken <authtoken>
API_BEARER_TOKEN=

# LLM para /ai_validator, a través de OpenRouter.
# Crea la clave en https://openrouter.ai/settings/keys (no es el API_BEARER_TOKEN).
OPENROUTER_API_KEY=
# Modelo a usar (lista en https://openrouter.ai/models). Vacío = anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Base de datos. El servicio usa un solo motor a la vez.
# SQLite (por defecto, sin servidor):
DATABASE_URL=sqlite:///./personas.db
# PostgreSQL (requiere psycopg). Después ejecuta: python preparar_postgres.py
# DATABASE_URL=postgresql+psycopg://postgres:ESCRIBE_TU_CLAVE@localhost:5432/practica
# MySQL (requiere PyMySQL):
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/practica?charset=utf8mb4
# MariaDB (requiere PyMySQL):
# DATABASE_URL=mariadb+pymysql://usuario:clave@localhost:3306/practica?charset=utf8mb4
